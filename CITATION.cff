      University, Singapore
  - family-names: Sheikh
    given-names: Haris Moazam
    affiliation: >-
      Department of Aeronautical and Astronautical Engineering, University of
      Southampton, United Kingdom
version: "1.0"
date-released: "2026-10-02"
license: BSD-3-Clause
